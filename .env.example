# cakeclaw 环境变量模板
# 复制为 .env 后填写实际值，禁止提交至 git

# ── 可选：域名（有空填，不填走 IP + 8080）──
DOMAIN=

# ── 必填：至少一个模型 API Key ──
# Gateway 内置各 provider 默认端点，只填 key 即可
# 如需自定义 URL（代理/本地 Ollama），在 gateway.json 的 models.providers 里配
ANTHROPIC_API_KEY=

GROK_API_KEY=

# ── 可选：非交互自动配置模型 provider（设为非空则 install.sh 在无 TTY 时也自动写入）──
# 适用于 CI / 一键脚本场景，避免交互式配置被跳过而需手改 openclaw.json。
# 留空 = 保持原交互行为（有 TTY 时提问，无 TTY 时跳过）。
# CAKECLAW_PROVIDER_NAME=my-provider     # provider 名称
# CAKECLAW_PROVIDER_BASE_URL=https://your-host/v1   # 你的中转站/兼容端点
# CAKECLAW_PROVIDER_API=openai-completions   # openai-completions / openai-responses / anthropic-messages / azure-openai-responses
# CAKECLAW_PROVIDER_KEY=sk-xxx
# CAKECLAW_PROVIDER_MODELS=model-a,model-b   # 逗号分隔；留空则尝试自动拉 /models
CAKECLAW_PROVIDER_NAME=
CAKECLAW_PROVIDER_BASE_URL=
CAKECLAW_PROVIDER_API=
CAKECLAW_PROVIDER_KEY=
CAKECLAW_PROVIDER_MODELS=

# ── 可选：覆盖默认值 ──
GATEWAY_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1
GATEWAY_PORT=18789
GATEWAY_MEM_LIMIT=
GATEWAY_CPU_LIMIT=
GATEWAY_PID_LIMIT=1024
SSH_PORT=22
BACKUP_RETENTION_DAYS=7
CONN_LIMIT=15
SWAP_SIZE=2G

# ── 可选：Codex Responses 修复（两方案二选一，勿同时开）──
# 作用：让指定 provider 走 Codex Responses 路径，把 system prompt 提升为顶层 instructions，
#       修复自定义 provider 指向 ChatGPT Subscription / Codex 后端时的 400 System messages are not allowed。
# 实现：bind mount 一个从官方 dist 派生的补丁文件（patches/ 内）+ 环境变量白名单，不重新 build 镜像。
# provider 名不硬编码，由 CODEX_RESPONSES_PROVIDERS 指定。
#
# 两个开关（等价于 install.sh 参数）：
#   CODEX_FIX=1     # Option C：不改 api 判定，需模型 api 已是 openai-chatgpt-responses / openclaw-openai-responses-transport
#   CODEX_FIX_B=1   # 方案 B：额外支持 api=openai-responses（改 dist 两处），绝大多数自定义 Codex 中转用这个
#
# 用法：sudo ./scripts/install.sh --with-codex-fix      # Option C
#      sudo ./scripts/install.sh --with-codex-fix-b    # 方案 B
# 或 .env 里二选一设 CODEX_FIX=1 / CODEX_FIX_B=1
# CODEX_FIX=1                       # Option C（互斥 CODEX_FIX_B）
# CODEX_FIX_B=1                     # 方案 B（互斥 CODEX_FIX）
# CODEX_RESPONSES_PROVIDERS=caner   # 逗号分隔的 provider 名列表；留空则手动填
